rules_version = '2';

// Milestone 1 baseline: deny by default, open only what the foundation needs.
// Rules grow per collection as each feature lands; every change is covered by emulator tests.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers -----------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ---- Public content ------------------------------------------------------
    match /membershipPlans/{planId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /gymSettings/{settingId} {
      allow read: if settingId == 'public' || isAdmin();
      allow write: if isAdmin();
    }

    // ---- Users -------------------------------------------------------------
    // Profiles are created by the createStudent Cloud Function (Admin SDK bypasses rules).
    // Role and feature flags can never be changed through client writes.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin()
        && request.resource.data.role == resource.data.role;
    }

    // Everything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
